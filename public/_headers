# Long browser caching so repeat visits open instantly.
/static/*
  Cache-Control: public, max-age=31536000, immutable
/v/*
  Cache-Control: public, max-age=2592000
/optimized/*
  Cache-Control: public, max-age=2592000
/logos/*
  Cache-Control: public, max-age=2592000
# Rioni TV brand book (eshelon.ge/rioni-tv): video, frames and fonts rarely change.
/rioni-tv/media/*
  Cache-Control: public, max-age=604800
/rioni-tv/fonts/*
  Cache-Control: public, max-age=2592000
/rioni-tv/img/*
  Cache-Control: public, max-age=86400
